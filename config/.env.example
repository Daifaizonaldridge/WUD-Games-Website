PRODUCTION=false
API_PATH=http://localhost:8080

# Local PostgreSQL credentials from compose.yaml
JDBC_DATABASE_USERNAME=myuser
JDBC_DATABASE_PASSWORD=secret
DEFAULT_ADMIN_EMAIL=example@gmail.com
# Development admin password is "password" (bcrypt hash, 12 rounds).
DEFAULT_ADMIN_PASSWORD='$2a$12$XcmLV3Vkl6/tHwEAzF7uWuIe4HMq2R841x8p6m3.O7hJSoPYsWH7O'

# Replace these placeholders to enable Google sign-in.
OAUTH2_GOOGLE_CLIENT_ID=local-test-client
OAUTH2_GOOGLE_CLIENT_SECRET=local-test-secret
